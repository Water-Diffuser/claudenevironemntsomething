{
  "name": "indulgent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "INDULGENT — a game-styled local dashboard for watching Claude Code work on your codebase.",
  "scripts": {
    "start": "concurrently -n server,web -c magenta,cyan \"npm:server\" \"npm:web\"",
    "server": "tsx watch --clear-screen=false server/index.ts",
    "web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
