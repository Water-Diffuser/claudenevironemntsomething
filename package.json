    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.49.0",
    "mermaid": "^12.0.0",
