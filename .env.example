# Copy this file to ".env" (same folder) and fill in your key.
#
# 1. Go to https://console.anthropic.com  ->  Settings  ->  API Keys  ->  Create Key
# 2. Paste it below, after the equals sign (no quotes, no spaces).
# 3. Restart the app (Ctrl+C, then `npm start`).
#
# If you already use Claude Code in a terminal and are logged in there, you can
# leave this blank - the app will try to reuse that login.
ANTHROPIC_API_KEY=

# Optional: force "rehearsal" (a scripted fake session, no key, no cost) or "live".
# INDULGENT_MODE=rehearsal

# Optional: pass ALL environment variables to Claude Code untouched (only needed in unusual setups).
# INDULGENT_KEEP_ENV=1
